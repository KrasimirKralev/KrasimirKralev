{
  "name": "contribution-invaders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "My GitHub contribution graph as a self-playing Space Invaders game, starring the ClawBox crab",
  "scripts": {
    "build:svg": "tsx src/index.ts",
    "build:assets": "python3 scripts/build-brand-assets.py",
    "preview": "tsx scripts/preview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
